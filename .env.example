# All optional.
# Where `npm run dev` forwards the bot's paths (/api, /auth, /static, /healthz) to. Default: the bot's dev API
# (`python scripts/dev_api.py` in doomtp-bot) on http://127.0.0.1:8080. Keep real values in .env.local, never here.
VITE_DEV_BOT_TARGET=
# vexoulz-auth, the sign-in shared by the *.vexoul.net sites (default: off). Empty turns sign-in off.
VITE_AUTH_BASE=https://auth.example.net
